<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the app tell when the phone is offline, to say so on screen. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Daily reminders as system notifications (asked for on Android 13 and later). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Every Android app needs this manifest. All UI is Jetpack Compose; the theme is
         Android's built-in one and the colours and fonts come from MoneyTrailTheme. -->
    <application
        android:name=".MoneyTrailApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="MoneyTrail"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
