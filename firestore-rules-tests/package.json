{
  "name": "moneytrail-firestore-rules-tests",
  "private": true,
  "description": "Checks app/firestore.rules against the Firestore emulator.",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-moneytrail \"mocha --timeout 20000 rules.test.js\"",
    "test:only": "mocha --timeout 20000 rules.test.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "firebase-tools": "^14.0.0",
    "mocha": "^10.7.0"
  }
}
